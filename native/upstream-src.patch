index fece830..8127268 100755
--- a/make.sh
+++ b/make.sh
@@ -277,6 +277,12 @@ apply_config() {
             "site")
                 set_site "$value"
                 ;;
+            "managePackages")
+                # RuStore-расширение: видимость пакетов + установка APK.
+                set_var "managePackages = $value"
+                update_permission "android.permission.QUERY_ALL_PACKAGES" "$value"
+                update_permission "android.permission.REQUEST_INSTALL_PACKAGES" "$value"
+                ;;
             *)
                 set_var "$key = $value"
                 ;;
